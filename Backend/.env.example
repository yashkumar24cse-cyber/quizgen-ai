# Copy this file to .env and fill in real values. Never commit .env to git.

# ─── Database ──────────────────────────────────────────────────────────────────
# MongoDB connection string. Leave as-is for local dev, replace with your
# Atlas/hosted URI in production.
MONGO_URI=mongodb://127.0.0.1:27017/quizgen

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# Example: http://localhost:3000,https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── AI Generation ─────────────────────────────────────────────────────────────
# Only needed if you want AI-generated quiz questions (recommended).
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend URL ──────────────────────────────────────────────────────────────
# Used to generate correct links in spaced-repetition reminder emails.
# Set this to your deployed frontend URL in production.
# Example: https://quizgen.vercel.app
FRONTEND_URL=http://localhost:8080

# ─── Email (Spaced Repetition Reminders) ───────────────────────────────────────
# Optional. If set, spaced-repetition reminder emails are sent via Resend.
# Get a key at https://resend.com  — leave blank to use console mock mode.
RESEND_API_KEY=

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# All windows are in milliseconds.
# /upload  and /generate-quiz: default 20 requests per 15 minutes per IP
RATE_UPLOAD_WINDOW_MS=900000
RATE_UPLOAD_MAX=20
RATE_GENERATE_WINDOW_MS=900000
RATE_GENERATE_MAX=20
# /create-quiz: default 30 requests per hour per IP
RATE_CREATE_WINDOW_MS=3600000
RATE_CREATE_MAX=30

# ─── Admin ─────────────────────────────────────────────────────────────────────
# A secret key required in the X-Admin-Key header to access GET /admin/dashboard
# and POST /admin/recalibrate. Leave blank to disable the endpoints.
ADMIN_API_KEY=

# ─── Audio Debrief (ElevenLabs TTS) ───────────────────────────────────────────
# Optional. If set, GET /quiz/:code/debrief returns an audio/mpeg file instead
# of JSON. Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
# Voice ID to use. Defaults to "EXAVITQu4vr4xnSDxMaL" (Bella) if not set.
ELEVENLABS_VOICE_ID=

# ─── Question Limits ───────────────────────────────────────────────────────────
# Hard ceiling on questions per /generate-quiz call. Requests above this return 400.
MAX_QUESTION_COUNT=100

# ─── AI Batch Generation ───────────────────────────────────────────────────────
# When AI generates more questions than BATCH_THRESHOLD, requests are split into
# parallel batches of BATCH_SIZE (concurrency capped at 3).
BATCH_THRESHOLD=20
BATCH_SIZE=15

# ─── Background Job Queue ──────────────────────────────────────────────────────
# AI requests with count > BG_JOB_THRESHOLD return a jobId immediately (HTTP 202).
# Poll GET /generate-quiz/status/:jobId for the result.
BG_JOB_THRESHOLD=30

# ─── Leaderboard Cache ─────────────────────────────────────────────────────────
# TTL for the in-memory leaderboard cache (milliseconds). Invalidated on every
# POST /save-result. Default 30 seconds.
LEADERBOARD_CACHE_TTL_MS=30000

# ─── Result Retention ─────────────────────────────────────────────────────────
# MongoDB TTL index: Result documents older than this many days are auto-deleted.
# Set to 0 to keep results forever (not recommended for large deployments).
RESULT_TTL_DAYS=90

# ─── Live Classroom / Demo Day Settings ────────────────────────────────────────
# The rate limits above are keyed by IP address, not by person. If 10+ people
# on the SAME wifi (a classroom, a hostel floor) all share one public IP, they
# share one bucket. Playing/scoring an existing quiz is NOT rate-limited at all
# (see /quiz/:code, /save-result, /leaderboard/:code in server.js) so this only
# matters if several people try to GENERATE their own separate quizzes around
# the same time. If you're demoing to a room of people who might each generate
# their own quiz, temporarily raise these before class:
# RATE_GENERATE_MAX=100
# RATE_UPLOAD_MAX=100
# Remember to lower them again afterward if this stays publicly hosted.
